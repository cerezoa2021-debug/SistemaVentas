@using SistemaVentas.Models
@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<h2>Eliminar producto</h2>
<p>¿Seguro que deseas eliminar el producto <strong>@Model.Nombre</strong>?</p>

<dl class="row">
    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria?.Nombre</dd>
    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Precio.ToString("0.##") Bs</dd>
    <dt class="col-sm-3">Stock</dt>
    <dd class="col-sm-9">@Model.Stock</dd>
</dl>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
