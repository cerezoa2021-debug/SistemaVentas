@using SistemaVentas.Models
@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Productos</h2>
    <a class="btn btn-success" asp-action="Create">Nuevo producto</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Stock mínimo</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria?.Nombre</td>
                <td>@producto.Precio.ToString("0.##") Bs</td>
                <td>@producto.Stock</td>
                <td>@producto.StockMinimo</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-success" asp-action="Reponer" asp-route-id="@producto.Id">Reponer</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@producto.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@producto.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
