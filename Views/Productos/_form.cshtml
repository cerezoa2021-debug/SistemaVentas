@using SistemaVentas.Models
@model Producto

<input type="hidden" asp-for="Id" />

<div asp-validation-summary="All" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label">Categoría</label>
    <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
        <option value="">Selecciona una categoría</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Precio" class="form-label">Precio</label>
    <div class="input-group">
        <input asp-for="Precio" type="number" min="0" step="0.01" class="form-control" />
        <span class="input-group-text">Bs</span>
    </div>
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Stock" class="form-label">Stock</label>
    <input asp-for="Stock" type="number" min="0" class="form-control" />
    <span asp-validation-for="Stock" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
    <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
    <span asp-validation-for="StockMinimo" class="text-danger"></span>
</div>

<button type="submit" class="btn btn-primary">Guardar</button>
<a class="btn btn-secondary" asp-action="Index">Cancelar</a>
