@model ReporteClientesViewModel
@{
    ViewData["Title"] = "Clientes";
}
<section class="reports-page">
    <div class="report-page-heading">
        <div><span class="reports-eyebrow">REPORTE DE CLIENTES</span><h2>Listado de clientes</h2></div>
        <a class="btn btn-outline-secondary btn-sm no-print" asp-action="Index"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Reportes</a>
    </div>
    <form class="report-filter no-print" asp-action="Clientes" method="get">
        <div class="report-filter-field report-client-filter">
            <label for="busqueda">Buscar cliente</label>
            <input class="form-control" id="busqueda" name="busqueda" type="search" maxlength="120" value="@Model.Busqueda" placeholder="Nombre, celular o correo" />
        </div>
        <div class="report-filter-field">
            <label for="comprasFiltro">Compras</label>
            <select class="form-select" id="comprasFiltro" name="comprasFiltro">
                <option value="Todas" selected="@(Model.ComprasFiltro == "Todas")">Todos</option>
                <option value="Con compras" selected="@(Model.ComprasFiltro == "Con compras")">Con compras</option>
                <option value="Sin compras" selected="@(Model.ComprasFiltro == "Sin compras")">Sin compras</option>
            </select>
        </div>
        <div class="report-filter-field"><label for="desde">Desde <span>(opcional)</span></label><input class="form-control" id="desde" name="desde" type="date" value="@Model.Desde?.ToString("yyyy-MM-dd")" /></div>
        <div class="report-filter-field"><label for="hasta">Hasta <span>(opcional)</span></label><input class="form-control" id="hasta" name="hasta" type="date" value="@Model.Hasta?.ToString("yyyy-MM-dd")" /></div>
        <div class="report-filter-field">
            <label for="orden">Ordenar por</label>
            <select class="form-select" id="orden" name="orden">
                <option value="nombre" selected="@(Model.Orden == "nombre")">Nombre (A-Z)</option>
                <option value="compras" selected="@(Model.Orden == "compras")">Más compras</option>
                <option value="monto" selected="@(Model.Orden == "monto")">Mayor monto comprado</option>
            </select>
        </div>
        <input type="hidden" name="tamanoPagina" value="@Model.TamanoPagina" />
        <div class="report-filter-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Buscar</button></div>
        <a class="btn btn-outline-secondary" asp-action="Clientes">Limpiar filtros</a>
    </form>
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    <div class="report-toolbar no-print">
        @if (Model.Error is null)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="ExportarClientesCsv" asp-route-busqueda="@Model.Busqueda"
               asp-route-comprasFiltro="@Model.ComprasFiltro" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")"
               asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-orden="@Model.Orden">
                <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>Exportar CSV
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Clientes" asp-route-busqueda="@Model.Busqueda"
               asp-route-comprasFiltro="@Model.ComprasFiltro" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")"
               asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-orden="@Model.Orden" asp-route-imprimir="true">
                <i class="bi bi-printer me-1" aria-hidden="true"></i>Imprimir
            </a>
        }
    </div>
    <article class="report-paper">
        <partial name="_EncabezadoImpresion" model="Model" />
        <h3 class="report-paper-title">Clientes y compras vigentes</h3>
        @if (Model.Error is null)
        {
            <div class="table-responsive">
                <table class="table report-table align-middle">
                    <thead><tr><th>Nombre</th><th>Celular</th><th>Correo electrónico</th><th class="text-end">Cantidad de compras</th><th class="text-end">Monto total</th></tr></thead>
                    <tbody>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <tr><td>@cliente.Nombre</td><td>@(string.IsNullOrEmpty(cliente.Celular) ? "—" : cliente.Celular)</td><td>@(string.IsNullOrEmpty(cliente.Correo) ? "—" : cliente.Correo)</td><td class="text-end">@cliente.Compras</td><td class="text-end">@cliente.MontoTotal.ToString("N2") Bs</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalFilas == 0)
            {
                <p class="report-empty">No hay datos para los filtros seleccionados</p>
            }
        }
    </article>
    @if (Model.Error is null && !Model.EsImpresion)
    {
        <form class="report-pagination no-print" asp-action="Clientes" method="get">
            <input type="hidden" name="busqueda" value="@Model.Busqueda" />
            <input type="hidden" name="comprasFiltro" value="@Model.ComprasFiltro" />
            <input type="hidden" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="orden" value="@Model.Orden" />
            <span>Mostrando @Model.PrimeraFila-@Model.UltimaFila de @Model.TotalFilas</span>
            <label for="tamanoPagina">Filas por página</label>
            <select id="tamanoPagina" name="tamanoPagina" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="25" selected="@(Model.TamanoPagina == 25)">25</option>
                <option value="50" selected="@(Model.TamanoPagina == 50)">50</option>
                <option value="100" selected="@(Model.TamanoPagina == 100)">100</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm" type="submit" name="pagina" value="@(Model.Pagina - 1)" disabled="@(Model.Pagina <= 1)">Anterior</button>
            <button class="btn btn-outline-secondary btn-sm" type="submit" name="pagina" value="@(Model.Pagina + 1)" disabled="@(Model.Pagina >= Model.TotalPaginas)">Siguiente</button>
        </form>
    }
</section>
@if (Model.EsImpresion)
{
    <script>window.addEventListener("load", () => window.print());</script>
}
