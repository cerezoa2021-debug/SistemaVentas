@model ReporteVentasViewModel
@{
    ViewData["Title"] = "Ventas por fechas";
}
<section class="reports-page">
    <div class="report-page-heading">
        <div><span class="reports-eyebrow">REPORTE DE VENTAS</span><h2>Ventas por rango de fechas</h2></div>
        <a class="btn btn-outline-secondary btn-sm no-print" asp-action="Index"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Reportes</a>
    </div>
    <form class="report-filter no-print" asp-action="Ventas" method="get" data-date-range>
        <div class="report-filter-field"><label for="desde">Desde</label><input class="form-control" id="desde" name="desde" type="date" required value="@Model.Desde?.ToString("yyyy-MM-dd")" /></div>
        <div class="report-filter-field"><label for="hasta">Hasta</label><input class="form-control" id="hasta" name="hasta" type="date" required value="@Model.Hasta?.ToString("yyyy-MM-dd")" /></div>
        <div class="report-filter-field report-client-filter">
            <label for="clienteId">Cliente <span>(opcional)</span></label>
            <select class="form-select" id="clienteId" name="clienteId">
                <option value="">Todos los clientes</option>
                @foreach (var cliente in Model.Clientes)
                {
                    <option value="@cliente.Id" selected="@(Model.ClienteId == cliente.Id)">@cliente.Nombre</option>
                }
            </select>
        </div>
        <div class="report-filter-field">
            <label for="categoriaId">Categoría</label>
            <select class="form-select" id="categoriaId" name="categoriaId">
                <option value="">Todas las categorías</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                }
            </select>
        </div>
        <div class="report-filter-field">
            <label for="estado">Estado</label>
            <select class="form-select" id="estado" name="estado">
                <option value="Todas" selected="@(Model.Estado == "Todas")">Todas</option>
                <option value="Vigentes" selected="@(Model.Estado == "Vigentes")">Vigentes</option>
                <option value="Anuladas" selected="@(Model.Estado == "Anuladas")">Anuladas</option>
            </select>
        </div>
        <input type="hidden" name="tamanoPagina" value="@Model.TamanoPagina" />
        <div class="report-filter-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtrar</button></div>
        <a class="btn btn-outline-secondary" asp-action="Ventas">Limpiar filtros</a>
    </form>
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    <div class="report-toolbar no-print">
        @if (Model.Error is null)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="ExportarVentasCsv"
               asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")"
               asp-route-clienteId="@Model.ClienteId" asp-route-categoriaId="@Model.CategoriaId" asp-route-estado="@Model.Estado">
                <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i>Exportar CSV
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Ventas" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")"
               asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-clienteId="@Model.ClienteId"
               asp-route-categoriaId="@Model.CategoriaId" asp-route-estado="@Model.Estado" asp-route-imprimir="true">
                <i class="bi bi-printer me-1" aria-hidden="true"></i>Imprimir
            </a>
        }
    </div>
    <article class="report-paper">
        <partial name="_EncabezadoImpresion" model="Model" />
        <h3 class="report-paper-title">Ventas por rango de fechas</h3>
        @if (Model.Error is null)
        {
            <div class="table-responsive">
                <table class="table report-table align-middle">
                    <thead><tr><th>Fecha</th><th>Cliente</th><th class="text-end">Total</th>@if (Model.FiltraCategoria){<th class="text-end">Subtotal categoría</th>}<th class="text-end">Recibido</th><th class="text-end">Cambio</th><th>Estado</th></tr></thead>
                    <tbody>
                    @foreach (var venta in Model.Ventas)
                    {
                        <tr class="@(venta.Anulada ? "report-cancelled" : "")">
                            <td>@venta.Fecha.ToString("dd/MM/yyyy")</td><td>@venta.Cliente</td>
                            <td class="text-end">@venta.Total.ToString("N2") Bs</td>
                            @if (Model.FiltraCategoria){<td class="text-end">@venta.SubtotalCategoria.ToString("N2") Bs</td>}
                            <td class="text-end">@venta.Recibido.ToString("N2") Bs</td>
                            <td class="text-end">@venta.Cambio.ToString("N2") Bs</td>
                            <td><span class="badge @(venta.Anulada ? "text-bg-danger" : "text-bg-success")">@(venta.Anulada ? "Anulada" : "Vigente")</span></td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2">Totales de ventas vigentes (@Model.CantidadVentas)</th>
                            <th class="text-end">@(Model.FiltraCategoria ? "—" : Model.TotalVentas.ToString("N2") + " Bs")</th>
                            @if (Model.FiltraCategoria){<th class="text-end">@Model.TotalVentas.ToString("N2") Bs</th>}
                            <th class="text-end">@Model.TotalRecibido.ToString("N2") Bs</th>
                            <th class="text-end">@Model.TotalCambio.ToString("N2") Bs</th><th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (Model.TotalFilas == 0)
            {
                <p class="report-empty">No hay datos para los filtros seleccionados</p>
            }
        }
    </article>
    @if (Model.Error is null && !Model.EsImpresion)
    {
        <form class="report-pagination no-print" asp-action="Ventas" method="get">
            <input type="hidden" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="clienteId" value="@Model.ClienteId" />
            <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
            <input type="hidden" name="estado" value="@Model.Estado" />
            <span>Mostrando @Model.PrimeraFila-@Model.UltimaFila de @Model.TotalFilas</span>
            <label for="tamanoPagina">Filas por página</label>
            <select id="tamanoPagina" name="tamanoPagina" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="25" selected="@(Model.TamanoPagina == 25)">25</option>
                <option value="50" selected="@(Model.TamanoPagina == 50)">50</option>
                <option value="100" selected="@(Model.TamanoPagina == 100)">100</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm" type="submit" name="pagina" value="@(Model.Pagina - 1)" disabled="@(Model.Pagina <= 1)">Anterior</button>
            <button class="btn btn-outline-secondary btn-sm" type="submit" name="pagina" value="@(Model.Pagina + 1)" disabled="@(Model.Pagina >= Model.TotalPaginas)">Siguiente</button>
        </form>
    }
</section>
@if (Model.EsImpresion)
{
    <script>window.addEventListener("load", () => window.print());</script>
}
