@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var links = new[]
    {
        new { Controller = "Home", Action = "Index", Text = "Dashboard", Icon = "bi-grid-1x2" },
        new { Controller = "Ventas", Action = "Index", Text = "Ventas", Icon = "bi-receipt" },
        new { Controller = "Reportes", Action = "Index", Text = "Reportes", Icon = "bi-bar-chart-line" },
        new { Controller = "Productos", Action = "Index", Text = "Productos", Icon = "bi-box-seam" },
        new { Controller = "Categorias", Action = "Index", Text = "Categorías", Icon = "bi-tags" },
        new { Controller = "Clientes", Action = "Index", Text = "Clientes", Icon = "bi-people" }
    };
}
<nav class="sidebar-navigation" aria-label="Navegación principal">
    <span class="sidebar-section-title">MENÚ PRINCIPAL</span>
    @foreach (var link in links)
    {
        var active = string.Equals(currentController, link.Controller, StringComparison.OrdinalIgnoreCase);
        <a class="sidebar-link @(active ? "active" : "")" asp-controller="@link.Controller" asp-action="@link.Action"
           aria-current="@(active ? "page" : null)">
            <i class="bi @link.Icon" aria-hidden="true"></i><span>@link.Text</span>
        </a>
    }
</nav>
