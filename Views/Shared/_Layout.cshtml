<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Ventas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes")
    {
        <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
    }
</head>
<body>
    <aside class="app-sidebar d-none d-lg-flex">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-shop-window" aria-hidden="true"></i></span>
            <span>Sistema de Ventas</span>
        </a>
        <partial name="_SidebarNavigation" />
        <div class="sidebar-footer">Gestión simple, ventas inteligentes</div>
    </aside>

    <div class="offcanvas offcanvas-start mobile-sidebar" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" id="mobileSidebarLabel">
                <span class="brand-mark"><i class="bi bi-shop-window" aria-hidden="true"></i></span>
                <span>Sistema de Ventas</span>
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar menú"></button>
        </div>
        <div class="offcanvas-body">
            <partial name="_SidebarNavigation" />
        </div>
    </div>

    <div class="app-main">
        <header class="topbar">
            <div class="topbar-title">
                <button class="btn btn-link mobile-menu-button d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#mobileSidebar" aria-controls="mobileSidebar" aria-label="Abrir menú">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <div>
                    <span class="topbar-eyebrow">SISTEMA DE VENTAS</span>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
            <div class="topbar-actions">
                <a class="btn btn-primary new-sale-button" asp-controller="Ventas" asp-action="Create">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Nueva venta</span>
                </a>
                <button class="btn btn-theme" type="button" id="themeToggle" aria-label="Cambiar a modo oscuro">
                    <i class="bi bi-moon-stars" aria-hidden="true"></i>
                </button>
                @await Component.InvokeAsync("StockAlerts")
                <span class="user-name"><i class="bi bi-person-circle" aria-hidden="true"></i> @(User.Identity?.Name ?? "Administrador")</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary logout-button">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Salir</span>
                    </button>
                </form>
            </div>
        </header>

        <main class="app-content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
