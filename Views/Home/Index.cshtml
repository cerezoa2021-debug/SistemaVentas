@using System.Globalization
@using System.Text.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var labels = Model.WeeklySales.Select(sale => sale.Date.ToString("ddd dd/MM", CultureInfo.GetCultureInfo("es"))).ToArray();
    var values = Model.WeeklySales.Select(sale => sale.Amount).ToArray();
}

<div class="dashboard">
    <div class="dashboard-heading">
        <div>
            <span class="dashboard-eyebrow">PANEL DE CONTROL</span>
            <h2>Resumen general</h2>
            <p>Esto es lo que sucede en tu negocio hoy, @Model.Today.ToString("dd 'de' MMMM", CultureInfo.GetCultureInfo("es")).</p>
        </div>
        <a class="dashboard-primary-button" asp-controller="Ventas" asp-action="Create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nueva venta
        </a>
    </div>

    <section class="metric-grid" aria-label="Resumen del negocio">
        <article class="metric-card metric-card-blue">
            <div class="metric-topline"><span class="metric-label">Ventas de hoy</span><i class="bi bi-cash-coin metric-icon" aria-hidden="true"></i></div>
            <strong class="metric-value">@Model.TodaySalesAmount.ToString("N2") <small>Bs</small></strong>
            <span class="metric-caption">@Model.TodaySalesCount ventas vigentes</span>
        </article>
        <article class="metric-card metric-card-violet">
            <div class="metric-topline"><span class="metric-label">Ventas del mes</span><i class="bi bi-graph-up-arrow metric-icon" aria-hidden="true"></i></div>
            <strong class="metric-value">@Model.MonthSalesAmount.ToString("N2") <small>Bs</small></strong>
            <span class="metric-caption">@Model.MonthSalesCount ventas vigentes</span>
        </article>
        <article class="metric-card metric-card-green">
            <div class="metric-topline"><span class="metric-label">Productos</span><i class="bi bi-box-seam metric-icon" aria-hidden="true"></i></div>
            <strong class="metric-value">@Model.TotalProducts</strong>
            <span class="metric-caption">Productos en inventario</span>
        </article>
        <article class="metric-card metric-card-orange">
            <div class="metric-topline"><span class="metric-label">Stock bajo</span><i class="bi bi-exclamation-triangle metric-icon" aria-hidden="true"></i></div>
            <strong class="metric-value">@Model.LowStockProductsCount</strong>
            <span class="metric-caption">Productos por reponer</span>
        </article>
        <article class="metric-card metric-card-teal">
            <div class="metric-topline"><span class="metric-label">Clientes</span><i class="bi bi-people metric-icon" aria-hidden="true"></i></div>
            <strong class="metric-value">@Model.RegisteredClients</strong>
            <span class="metric-caption">Clientes registrados</span>
        </article>
    </section>

    <section class="dashboard-grid dashboard-grid-charts">
        <article class="dashboard-panel">
            <div class="panel-heading">
                <div>
                    <h3>Ventas de los últimos 7 días</h3>
                    <p>Ingresos diarios, sin ventas anuladas</p>
                </div>
                <span class="panel-tag">Esta semana</span>
            </div>
            <div class="weekly-chart-container">
                <canvas id="weeklySalesChart" role="img" aria-label="Gráfico de ventas de los últimos siete días"></canvas>
            </div>
        </article>

        <article class="dashboard-panel">
            <div class="panel-heading">
                <div>
                    <h3>Productos más vendidos</h3>
                    <p>Unidades vendidas históricamente</p>
                </div>
                <a class="panel-link" asp-controller="Reportes" asp-action="MasVendidos">Ver reporte <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            @if (Model.BestSellingProducts.Count == 0)
            {
                <div class="empty-state">Aún no hay productos vendidos.</div>
            }
            else
            {
                <div class="ranked-list">
                    @for (var i = 0; i < Model.BestSellingProducts.Count; i++)
                    {
                        var product = Model.BestSellingProducts[i];
                        <div class="ranked-item">
                            <span class="rank-number">@(i + 1)</span>
                            <div class="rank-product"><strong>@product.Name</strong><span>Unidades vendidas</span></div>
                            <span class="rank-quantity">@product.Quantity</span>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="dashboard-grid dashboard-grid-lists">
        <article class="dashboard-panel">
            <div class="panel-heading">
                <div><h3>Alertas de stock bajo</h3><p>Productos en su mínimo o por debajo</p></div>
                <a class="panel-link" asp-controller="Productos" asp-action="Index">Ver inventario <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            @if (Model.LowStockProducts.Count == 0)
            {
                <div class="empty-state stock-ok">Todo bien: no hay productos con stock bajo.</div>
            }
            else
            {
                <div class="ranked-list">
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <div class="ranked-item">
                            <div class="rank-product">
                                <strong>@product.Nombre</strong>
                                <span>@(product.Categoria?.Nombre ?? "Sin categoría") · mínimo @product.StockMinimo</span>
                            </div>
                            <span class="badge @(product.Stock == 0 ? "text-bg-danger" : "text-bg-warning")">
                                @(product.Stock == 0 ? "Agotado" : "Bajo") · @product.Stock
                            </span>
                            <a class="stock-restock-button" asp-controller="Productos" asp-action="Reponer" asp-route-id="@product.Id">Reponer</a>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="dashboard-panel recent-panel">
            <div class="panel-heading">
                <div><h3>Últimas ventas</h3><p>Actividad reciente del negocio</p></div>
                <a class="panel-link" asp-controller="Ventas" asp-action="Index">Ver todas <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            @if (Model.RecentSales.Count == 0)
            {
                <div class="empty-state">Todavía no hay ventas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="recent-table">
                        <thead><tr><th>Venta</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var sale in Model.RecentSales)
                            {
                                <tr>
                                    <td><span class="sale-id">#@sale.Id</span></td>
                                    <td>@(sale.Cliente?.Nombre ?? "Cliente no disponible")</td>
                                    <td>@sale.Fecha.ToString("dd/MM/yyyy · HH:mm")</td>
                                    <td><span class="badge @(sale.Anulada ? "text-bg-danger" : "text-bg-success")">@(sale.Anulada ? "Anulada" : "Vigente")</span></td>
                                    <td class="text-end sale-total">@sale.Total.ToString("N2") Bs</td>
                                    <td class="text-end"><a class="sale-detail-link" asp-controller="Ventas" asp-action="Details" asp-route-id="@sale.Id" aria-label="Ver venta @sale.Id"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById("weeklySalesChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(labels)),
                datasets: [{
                    label: "Ventas (Bs)",
                    data: @Html.Raw(JsonSerializer.Serialize(values)),
                    backgroundColor: "#6259e8",
                    hoverBackgroundColor: "#4136c4",
                    borderRadius: 7,
                    maxBarThickness: 42
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
