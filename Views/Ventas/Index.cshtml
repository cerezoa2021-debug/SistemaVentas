@using SistemaVentas.Models
@model List<Venta>
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a class="btn btn-success" asp-action="Create">Nueva venta</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Recibido</th>
            <th>Cambio</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venta in Model)
        {
            <tr>
                <td>@venta.Id</td>
                <td>@venta.Fecha.ToString("g")</td>
                <td>@venta.Cliente?.Nombre</td>
                <td>@venta.Total.ToString("0.##") Bs</td>
                <td>@venta.Recibido.ToString("0.##") Bs</td>
                <td>@venta.Cambio.ToString("0.##") Bs</td>
                <td>
                    @if (venta.Anulada)
                    {
                        <span class="badge text-bg-secondary">Anulada</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Vigente</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@venta.Id">Ver</a>
                    @if (!venta.Anulada)
                    {
                        <form asp-action="Anular" asp-route-id="@venta.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Anular la venta #@venta.Id? Se devolverán sus productos al stock.');">
                            <button type="submit" class="btn btn-sm btn-danger">Anular</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
