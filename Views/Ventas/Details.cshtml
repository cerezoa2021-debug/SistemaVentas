@using SistemaVentas.Models
@model Venta
@{
    ViewData["Title"] = $"Detalle de venta #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalle de venta #@Model.Id</h2>
    @if (Model.Anulada)
    {
        <span class="badge text-bg-secondary fs-6">Anulada</span>
    }
    else
    {
        <span class="badge text-bg-success fs-6">Vigente</span>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("g")</dd>
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente?.Nombre</dd>
</dl>

<h3>Productos</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model.Detalles)
        {
            <tr>
                <td>@detalle.Producto?.Nombre</td>
                <td class="text-end">@detalle.Cantidad</td>
                <td class="text-end">@detalle.Precio.ToString("0.##") Bs</td>
                <td class="text-end">@detalle.Subtotal.ToString("0.##") Bs</td>
            </tr>
        }
    </tbody>
</table>

<dl class="row">
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Total.ToString("0.##") Bs</dd>
    <dt class="col-sm-3">Recibido</dt>
    <dd class="col-sm-9">@Model.Recibido.ToString("0.##") Bs</dd>
    <dt class="col-sm-3">Cambio</dt>
    <dd class="col-sm-9">@Model.Cambio.ToString("0.##") Bs</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Volver a ventas</a>
