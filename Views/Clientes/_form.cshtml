@using SistemaVentas.Models
@model Cliente

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" required maxlength="120" inputmode="text" oninput="this.value = this.value.replace(/[0-9]/g, '')" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label">Correo electrónico</label>
    <input asp-for="Email" type="email" class="form-control" maxlength="254" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Celular" class="form-label">Celular</label>
    <input asp-for="Celular" type="tel" class="form-control" maxlength="8" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
    <span asp-validation-for="Celular" class="text-danger"></span>
</div>

<button type="submit" class="btn btn-primary">Guardar</button>
<a class="btn btn-secondary" asp-action="Index">Cancelar</a>
